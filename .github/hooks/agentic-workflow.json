{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "bash": "node \"$(git rev-parse --show-toplevel)/scripts/hooks/pre-tool-use.js\" copilot",
        "powershell": "node \"$(git rev-parse --show-toplevel)/scripts/hooks/pre-tool-use.js\" copilot",
        "timeoutSec": 30
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "bash \"$(git rev-parse --show-toplevel)/scripts/hooks/post-tool-use.sh\"",
        "powershell": "node \"$(git rev-parse --show-toplevel)/scripts/hooks/run-posix.mjs\" scripts/hooks/post-tool-use.sh",
        "timeoutSec": 60
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "bash \"$(git rev-parse --show-toplevel)/scripts/hooks/stop-docs-sync.sh\" copilot",
        "powershell": "node \"$(git rev-parse --show-toplevel)/scripts/hooks/run-posix.mjs\" scripts/hooks/stop-docs-sync.sh copilot",
        "timeoutSec": 10
      }
    ]
  }
}
